#!/usr/bin/env python3
"""Check every OS update feed on this repository's releases.

  check-feeds [--repo OWNER/REPO] [--key keys/marathon-ota.asc]

A feed is the release <channel>/<image id> (stable, or test as a
pre-release). Its SHA256SUMS must carry a good signature by the OTA key,
list every asset and nothing else, and agree with the AppStream catalog;
every asset must be under GitHub's 2 GiB limit, and small ones must match
their checksum. Payloads are not downloaded: systemd-sysupdate checks those
on the phone. Needs gh (authenticated, or GH_TOKEN), gpg and gpgv.
"""

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import xml.etree.ElementTree as ET
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
TAG = re.compile(r"^(stable|test)/([a-z0-9-]+_[a-z0-9-]+_[a-z0-9.-]+)$")
SIGNED = ("SHA256SUMS", "SHA256SUMS.gpg")
CATALOG = "marathon-os.metainfo.xml"
ASSET_MAX = 2 * 1024**3 - 1
FETCH_MAX = 16 * 1024**2
# A publish uploads the new version's files before the manifest that lists
# them, so the runs its uploads trigger see them unlisted for a while. One
# still unlisted after this long is left over from a publish that stopped.
PUBLISH_WINDOW = 30 * 60


def fetch(repo, asset):
    """An asset's bytes through the API, as the token's user: anonymous
    downloads are the first to time out when GitHub is overloaded."""
    for attempt in range(4):
        r = subprocess.run(["gh", "api", "-H", "Accept: application/octet-stream",
                            f"repos/{repo}/releases/assets/{asset['id']}"], capture_output=True)
        if r.returncode == 0:
            return r.stdout
        time.sleep(5 * (attempt + 1))
    raise RuntimeError(f"cannot fetch {asset['name']}: {r.stderr.decode().strip()}")


def uploading(asset):
    """Uploaded within PUBLISH_WINDOW: part of a publish still under way."""
    stamp = asset.get("updated_at") or asset.get("created_at") or ""
    try:
        uploaded = datetime.fromisoformat(stamp.replace("Z", "+00:00"))
    except ValueError:
        return False
    return (datetime.now(timezone.utc) - uploaded).total_seconds() < PUBLISH_WINDOW


def good_signature(data, sig, keyring):
    with tempfile.TemporaryDirectory() as tmp:
        d, s = Path(tmp) / "SHA256SUMS", Path(tmp) / "SHA256SUMS.gpg"
        d.write_bytes(data)
        s.write_bytes(sig)
        r = subprocess.run(["gpgv", "--status-fd", "1", "--keyring", str(keyring), str(s), str(d)],
                           capture_output=True, text=True)
    tokens = {line.split()[1] for line in r.stdout.splitlines() if line.startswith("[GNUPG:] ")}
    return r.returncode == 0 and {"GOODSIG", "VALIDSIG"} <= tokens


def check(release, keyring, repo):
    tag = release["tag_name"]
    channel, image_id = TAG.match(tag).groups()
    out = []
    if release["prerelease"] != (channel == "test"):
        out.append("stable feeds are releases, test feeds pre-releases")
    assets = {a["name"]: a for a in release["assets"]}
    for name in SIGNED + (CATALOG,):
        if name not in assets:
            return out + [f"no {name}"]
    sums = fetch(repo, assets["SHA256SUMS"])
    if not good_signature(sums, fetch(repo, assets["SHA256SUMS.gpg"]), keyring):
        out.append("SHA256SUMS.gpg is not a good signature by the OTA key")
    listed = {}
    for line in sums.decode().splitlines():
        digest, _, name = line.partition("  ")
        listed[name] = digest
    for name in sorted(set(assets) - set(listed) - set(SIGNED)):
        if uploading(assets[name]):
            print(f"{tag}: {name} is being published (not in SHA256SUMS yet)")
        else:
            out.append(f"{name} is an asset but not in SHA256SUMS")
    for name in sorted(set(listed) - set(assets)):
        out.append(f"{name} is in SHA256SUMS but not an asset")
    for name, asset in sorted(assets.items()):
        if asset["size"] > ASSET_MAX:
            out.append(f"{name} is over 2 GiB")
        if name in listed and asset["size"] <= FETCH_MAX:
            if hashlib.sha256(fetch(repo, asset)).hexdigest() != listed[name]:
                out.append(f"{name} does not match its checksum")
    versions = {m.group(1) for n in listed
                if (m := re.match(re.escape(image_id) + r"_([^._+]+)\.", n)) and not n.endswith(".notes")}
    catalog = ET.fromstring(fetch(repo, assets[CATALOG]))
    released = {r.get("version") for r in catalog.iter("release")}
    if released != versions:
        out.append(f"{CATALOG} lists {sorted(released)}, SHA256SUMS has {sorted(versions)}")
    if not versions:
        out.append("no version")
    return out


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--repo", default=os.environ.get("GITHUB_REPOSITORY", "patrickjquinn/marathon-updates"))
    parser.add_argument("--key", default=str(ROOT / "keys" / "marathon-ota.asc"))
    args = parser.parse_args()
    releases = json.loads(subprocess.run(
        ["gh", "api", "--paginate", "--slurp", f"repos/{args.repo}/releases"],
        capture_output=True, text=True, check=True).stdout)
    releases = [r for page in releases for r in page]
    failed = False
    with tempfile.TemporaryDirectory() as tmp:
        keyring = Path(tmp) / "ota.gpg"
        with open(args.key, "rb") as armored, open(keyring, "wb") as out:
            subprocess.run(["gpg", "--batch", "--dearmor"], stdin=armored, stdout=out, check=True)
        feeds = [r for r in releases if TAG.match(r["tag_name"]) and not r["draft"]]
        for release in sorted(feeds, key=lambda r: r["tag_name"]):
            found = check(release, keyring, args.repo)
            for p in found:
                print(f"{release['tag_name']}: {p}", file=sys.stderr)
            if not found:
                print(f"{release['tag_name']}: ok")
            failed |= bool(found)
        if not feeds:
            print("no feeds yet")
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
